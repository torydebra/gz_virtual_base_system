<?xml version="1.0"?>
<robot name="mobile_base" xmlns:xacro="http://www.ros.org/wiki/xacro">
    <xacro:include filename="$(find gz_virtual_base_system)/urdf/virtual_base_macro.urdf.xacro" />

    <link name="world"/>
    <xacro:virtual_base_system world_link="world" base_link="mobile_base_link" />

    <link name="mobile_base_link">
        <inertial>
            <origin xyz="0 0 0.35" rpy="0 0 0"/>
            <mass value="397.0"/>
            <inertia
                ixx="29.36" iyy="54.90" izz="51.84" 
                ixy="0.0" ixz="0.0" iyz="0.0"/>
        </inertial>
        <visual>
            <origin xyz="0 0 0.35" rpy="0 0 0"/>
            <geometry>
                <box size="1.08 0.63 0.70"/>
            </geometry>
        </visual>
        <collision name="base_collision">
            <origin xyz="0 0 0.35" rpy="0 0 0"/>
            <geometry>
                <box size="1.08 0.63 0.70"/>
            </geometry>
        </collision>
    </link>

    <gazebo>
        <plugin name="gz_ros2_control::GazeboSimROS2ControlPlugin"
            filename="gz_ros2_control-system">
            <parameters>$(find gz_virtual_base_system)/config/controllers_config_example.yaml</parameters>
            <!-- <ros>
                <namespace>mobile_base</namespace>
            </ros> -->
        </plugin>
    </gazebo>

</robot>
